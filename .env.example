# Copy to .env.local and adjust. NEXT_PUBLIC_* values are inlined at build time.

# ── Upload limits ────────────────────────────────────────────────
NEXT_PUBLIC_ISOLA_MAX_FILE_MB=30
NEXT_PUBLIC_ISOLA_MAX_DIMENSION=8000
NEXT_PUBLIC_ISOLA_MIN_DIMENSION=32
NEXT_PUBLIC_ISOLA_MAX_MEGAPIXELS=36
NEXT_PUBLIC_ISOLA_MAX_BATCH_FILES=50
NEXT_PUBLIC_ISOLA_BATCH_CONCURRENCY=1

# ── Export limits ────────────────────────────────────────────────
NEXT_PUBLIC_ISOLA_MAX_EXPORT_MEGAPIXELS=64
NEXT_PUBLIC_ISOLA_MAX_EXPORT_DIMENSION=12000

# ── On-device engine ─────────────────────────────────────────────
# Where model files are served from (default: /models/ from public/models).
# A cross-origin host must send CORS and Cross-Origin-Resource-Policy: cross-origin.
NEXT_PUBLIC_ISOLA_MODEL_BASE_URL=/models/
# Where ONNX Runtime Web files are served from (copied to public/ort on install).
NEXT_PUBLIC_ISOLA_ORT_BASE_URL=/ort/
# isnet-general-use (Standard) or birefnet-lite (High detail, WebGPU only).
NEXT_PUBLIC_ISOLA_DEFAULT_MODEL=isnet-general-use
# Set to true to force WebAssembly even when WebGPU is available.
NEXT_PUBLIC_ISOLA_DISABLE_WEBGPU=false

# ── Optional server engine (server-only; never exposed to the browser) ──
# ISOLA_REMOTE_PROVIDER=removebg
# REMOVE_BG_API_KEY=
# REMOVE_BG_SIZE=auto
# ISOLA_REMOTE_MAX_UPLOAD_MB=12
# ISOLA_REMOTE_RATE_LIMIT_PER_HOUR=30
# ISOLA_REMOTE_ALLOW_CROSS_ORIGIN=false

# ── Site ─────────────────────────────────────────────────────────
# Social links render only when set (GitHub defaults to the project repo).
# NEXT_PUBLIC_ISOLA_SOCIAL_GITHUB=https://github.com/your-org/isola
# NEXT_PUBLIC_ISOLA_SOCIAL_X=
# NEXT_PUBLIC_ISOLA_SOCIAL_INSTAGRAM=
# NEXT_PUBLIC_ISOLA_SOCIAL_LINKEDIN=
# NEXT_PUBLIC_ISOLA_SOCIAL_YOUTUBE=
# NEXT_PUBLIC_ISOLA_SUPPORT_EMAIL=
# NEXT_PUBLIC_ISOLA_LEGAL_ENTITY=ISOLA
