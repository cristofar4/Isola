# Copy to .env.local and adjust. NEXT_PUBLIC_* values are inlined at build time.

# ── Upload limits ────────────────────────────────────────────────
NEXT_PUBLIC_ISOLA_MAX_FILE_MB=30
NEXT_PUBLIC_ISOLA_MAX_DIMENSION=8000
NEXT_PUBLIC_ISOLA_MIN_DIMENSION=32
NEXT_PUBLIC_ISOLA_MAX_MEGAPIXELS=36
NEXT_PUBLIC_ISOLA_MAX_BATCH_FILES=50
NEXT_PUBLIC_ISOLA_BATCH_CONCURRENCY=1

# ── Export limits ────────────────────────────────────────────────
NEXT_PUBLIC_ISOLA_MAX_EXPORT_MEGAPIXELS=64
NEXT_PUBLIC_ISOLA_MAX_EXPORT_DIMENSION=12000

# ── On-device engine ─────────────────────────────────────────────
# Where the browser fetches model files. The default route only serves them to
# signed-in users. A cross-origin host must send CORS headers (the sign-in
# requirement is then enforced by the app UI only).
NEXT_PUBLIC_ISOLA_MODEL_BASE_URL=/api/models/
# Where the server keeps models, and whether it downloads missing ones.
# ISOLA_MODEL_DIR=./models
# ISOLA_MODEL_AUTO_DOWNLOAD=true
# ISOLA_MODEL_MIRROR=https://github.com/danielgatis/rembg/releases/download/v0.0.0/
# Where ONNX Runtime Web files are served from (copied to public/ort on install).
NEXT_PUBLIC_ISOLA_ORT_BASE_URL=/ort/
# isnet-general-use (Standard) or birefnet-lite (High detail, WebGPU only).
NEXT_PUBLIC_ISOLA_DEFAULT_MODEL=isnet-general-use
# Set to true to force WebAssembly even when WebGPU is available.
NEXT_PUBLIC_ISOLA_DISABLE_WEBGPU=false

# ── Optional server engine (server-only; never exposed to the browser) ──
# ISOLA_REMOTE_PROVIDER=removebg
# REMOVE_BG_API_KEY=
# REMOVE_BG_SIZE=auto
# ISOLA_REMOTE_MAX_UPLOAD_MB=12
# ISOLA_REMOTE_RATE_LIMIT_PER_HOUR=30
# ISOLA_REMOTE_ALLOW_CROSS_ORIGIN=false

# ── Public API (/api/v1, API keys from the Account page) ─────────
# Processing runs on this server with onnxruntime-node and the Standard model.
# ISOLA_API_RATE_LIMIT_PER_HOUR=60   # per key, in memory per instance
# ISOLA_API_MAX_QUEUE=8              # images that may wait; beyond that: 503 server_busy
# ISOLA_API_THREADS=0                # inference threads; 0 = all cores

# ── Accounts (server-only) ───────────────────────────────────────
# Required in production: a long random string, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Public URL of the site, used for OAuth callbacks and redirects.
BETTER_AUTH_URL=http://localhost:3000
# Postgres for production. Leave unset to use a local SQLite file.
# DATABASE_URL=postgres://user:password@host:5432/isola
# DATABASE_POOL_MAX=5
# ISOLA_SQLITE_PATH=.data/isola.db
# Set to false to create the auth tables with your own migration tooling.
# ISOLA_AUTH_AUTO_MIGRATE=true
# Extra origins allowed to call the auth API (comma-separated).
# ISOLA_TRUSTED_ORIGINS=
# Header your proxy sets with the client IP (used for auth rate limits).
# ISOLA_CLIENT_IP_HEADERS=x-forwarded-for
# ISOLA_TRUSTED_PROXIES=
# Google sign-in: redirect URI = {BETTER_AUTH_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GitHub sign-in: callback URL = {BETTER_AUTH_URL}/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── Email (password reset) ───────────────────────────────────────
# Sender shown in emails.
# EMAIL_FROM="ISOLA <no-reply@example.com>"
# Option 1: SMTP (works with most providers)
# SMTP_URL=smtps://user:password@smtp.example.com:465
#   or SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASSWORD / SMTP_SECURE=true
# Option 2: Resend HTTP API
# RESEND_API_KEY=
# With neither set, development prints confirmation and reset links in the
# server terminal; production turns off email confirmation and shows password
# reset as unavailable.

# ── Plans & payments (Paystack) ──────────────────────────────────
# Pro prices in naira (per month and per year), and the free plan's export size limit.
NEXT_PUBLIC_ISOLA_PRO_PRICE_NGN=14000
NEXT_PUBLIC_ISOLA_PRO_YEARLY_PRICE_NGN=140000
NEXT_PUBLIC_ISOLA_FREE_MAX_EXPORT_SIDE=1000
# Server-only. Without a secret key, upgrading shows as unavailable.
# PAYSTACK_SECRET_KEY=sk_live_...
# Optional: plans created in the Paystack dashboard for auto-renewal
# (₦14,000 monthly and ₦140,000 annually). Without them, each payment buys one
# month (or one year) of Pro and doesn't renew.
# PAYSTACK_PLAN_CODE=PLN_...
# PAYSTACK_YEARLY_PLAN_CODE=PLN_...
# Webhook URL to set in Paystack: {BETTER_AUTH_URL}/api/billing/webhook

# ── Site ─────────────────────────────────────────────────────────
# Social links render only when set (GitHub defaults to the project repo).
# NEXT_PUBLIC_ISOLA_SOCIAL_GITHUB=https://github.com/your-org/isola
# NEXT_PUBLIC_ISOLA_SOCIAL_X=
# NEXT_PUBLIC_ISOLA_SOCIAL_INSTAGRAM=
# NEXT_PUBLIC_ISOLA_SOCIAL_LINKEDIN=
# NEXT_PUBLIC_ISOLA_SOCIAL_YOUTUBE=
# NEXT_PUBLIC_ISOLA_SUPPORT_EMAIL=
# NEXT_PUBLIC_ISOLA_LEGAL_ENTITY=ISOLA
